# Keep the version file and the shell tooling LF on every platform.
#
# tools/version-sync.sh writes VERSION with a single LF, so a CRLF working-tree
# copy would leave the file reported as modified forever on Windows. Shell
# scripts must stay LF wherever they are checked out, or the shebang line breaks
# the moment they run outside Git for Windows.

VERSION       text eol=lf
*.sh          text eol=lf
tools/hooks/* text eol=lf
